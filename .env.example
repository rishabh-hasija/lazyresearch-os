# Copy to .env and supply local credentials. .env is ignored.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://lazyresearch:CHANGE_ME@127.0.0.1:55432/lazyresearch_dev
TEST_DATABASE_URL=postgresql+psycopg://lazyresearch:CHANGE_ME@127.0.0.1:55432/lazyresearch_test
MIGRATION_TEST_DATABASE_URL=postgresql+psycopg://lazyresearch:CHANGE_ME@127.0.0.1:55432/lazyresearch_migration_check
MAX_UPLOAD_BYTES=10485760
MAX_FETCH_BYTES=10485760
FETCH_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=5
READ_TIMEOUT_SECONDS=5
MAX_REDIRECTS=5
MAX_BATCH_ENTRIES=20
MAX_PDF_PAGES=200
EXTRACTION_TIMEOUT_SECONDS=15
MAX_EXTRACTED_CHARS=2000000
LEASE_SECONDS=90
# Source analysis (local Ollama; no model is automatically downloaded)
AI_PROVIDER=ollama
AI_MODEL=gemma4:e4b
AI_ENDPOINT=http://127.0.0.1:11434
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=4000
AI_MAX_CHUNKS=64
AI_MAX_OUTPUT_TOKENS=2400

# Retrieval: lexical is always available; optional local embeddings/pgvector.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:latest
EMBEDDING_DIMENSION=4096
EMBEDDING_ENDPOINT=http://127.0.0.1:11434
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=4
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
VECTOR_SEARCH_ENABLED=false
RETRIEVAL_LIMIT=5
RETRIEVAL_PER_SOURCE_LIMIT=2
RRF_K=60
